# ====================
# KirikoBot 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ====================

# QQ机器人账号
ROBOT_QQ="你的QQ号"

# OneBot API 地址
ONEBOT_API="http://llbot:3000"

# OneBot 连接令牌
ONEBOT_TOKEN="your_token_here"

# DeepSeek API 地址
DEEPSEEK_API="https://api.deepseek.com/chat/completions"

# DeepSeek API 密钥
DEEPSEEK_TOKEN="your_deepseek_api_key"

# 对话模型（DeepSeek V4.1 Flash，API 模型名 deepseek-flash）
# 全项目统一使用该模型：聊天、工具、塔罗、新闻翻译、画像、判定等
DEEPSEEK_MODEL="deepseek-flash"

# 思考强度（low/high/max，仅对开启思考模式的请求生效，默认 low）
# API 默认 high，思考 token 会明显拖慢回复；low 在保留工具选择能力的前提下更快
# 后台调用（新闻翻译/视觉/判定/画像）已显式关闭思考，不受此项影响
DEEPSEEK_REASONING_EFFORT="low"

# ── 补充设定（可选）──────────────────────────────
# Kiriko 的人设与说话方式已统一放在 prompt_builder.py 的 PERSONA 里（唯一来源），
# 这里只用来追加**部署方自己的补充要求**，且明确从属于 PERSONA —— 与它冲突时以 PERSONA 为准。
# 留空即可。之前这里写的「聊天小助手 / 可以使用颜文字」与 PERSONA 直接矛盾，已清空。
GROUP_ROLE=""
PRIVATE_ROLE=""
# 塔罗只是额外任务要求，人设同样来自 PERSONA
TAROT_ROLE="根据牌名和牌面信息解读，并给出一句温和的提醒"

# ── 图像识别（可选）──────────────────────
# V4.1 Flash 原生支持多模态，默认与聊天共用同一模型（DEEPSEEK_MODEL）
# 设为 "0" 可关闭图像识别（回退为上下文推断）
VISION_ENABLED="1"
# 需要单独指定视觉模型时再取消注释
# VISION_MODEL="deepseek-flash"

# ── 群聊背景语境（默认关闭）──────────────
# 读群聊语境**由模型自己决定**：觉得需要时调用 read_context 工具去翻。
# 这里开启的话，会额外把最近一段群聊无条件附在**每条**群消息前面——
# 相当于放弃"判断"这一步。曾经的默认值就是开，后来改回关了。
#
# 真正一直开启的是**引用回复的上下文获取**：消息如果引用了别的发言
# （尤其是别人引用机器人自己说过的话），被引用的内容总是会被还原并附上。
# 那是当前消息的既定事实，不需要模型判断，也没有开关。
GROUP_CONTEXT_ENABLED="0"
# 背景往回看多久、最多几条。调大更懂上下文，但每条群消息的 token 都会涨
# （默认 20 条约 350 tokens）
GROUP_CONTEXT_MINUTES="15"
GROUP_CONTEXT_LIMIT="20"

# ── 耐心窗口（情绪阶梯）─────────────────
# 机器人被同一个人反复问同样的事时会逐级升级：正常 → 敷衍/不耐烦 → 生气 → 掀桌不理。
# 这个窗口决定"算多久之内的骚扰"：调大 = 更不容易生气，调小 = 脾气更爆。
PATIENCE_WINDOW_MINUTES="10"
# 情绪冷却期：从最高一级消气回到正常要多久。太小会显得脾气来得快去得也快，
# 太大就会一直甩脸色。半小时接近正常人的情绪周期。
MOOD_COOLDOWN_MINUTES="30"

# ── 语音（默认开启）──────────────────────
# 让机器人偶尔直接用语音说话（走 LLBot 的 AI 语音合成，只支持群聊）。
# 由模型自己决定要不要说、以及用什么音色；发不出去会自动回退成文字。
# 需要 QQ 账号本身有 AI 语音功能，否则会回退文字（不会静默失败）。
VOICE_ENABLED="1"
# 默认音色。lucy-voice-f38 = 傲娇少女（可用列表见 get_ai_characters：
# xueling 元气少女 / female1 邻家小妹 / f36 温柔妹妹 / f37 文艺少女 /
# f34 书香少女 / female2 暖心姐姐 / suxinjiejie 酥心御姐 / houge 猴哥 等）
VOICE_DEFAULT_CHARACTER="lucy-voice-f38"

# ── LLBot 管理面板整合（可选）──────────────────────
# 面板的「连接状态 / WebQQ」页面会自动读取 llbot_config/webui_token.txt
# 登录 LLBot WebUI，通常无需配置下面两项。
# 后端访问地址（容器内网）
# LLBOT_WEBUI_URL="http://llbot:3080"
# 浏览器访问地址；留空则按当前访问域名 + 3080 端口自动推导。
# 面板跑在非默认端口映射下时再手工指定。
# LLBOT_WEBUI_PUBLIC_URL="http://192.168.1.10:3080"
# 密码文件位置；默认已指向容器内挂载路径 /app/llbot_config/webui_token.txt
# LLBOT_TOKEN_FILE="/app/llbot_config/webui_token.txt"
# 也可直接给出明文密码（不推荐，优先用上面的文件）
# LLBOT_WEBUI_TOKEN=""

# ── 安全 ────────────────────────────────────────────
# Webhook 验签密钥。LLBot 的 http-post 会用它在 x-signature 里附带
# HMAC-SHA1 签名；两边必须一致，否则事件会被 403 拒绝。
# 留空则回退到 ONEBOT_TOKEN（推荐做法：把 LLBot 配置里
# ob11 → http-post 连接的 token 填成与 ONEBOT_TOKEN 相同的值）。
# WEBHOOK_TOKEN=""

# 面板访问口令（HTTP Basic）。留空会在首次启动时自动生成，
# 保存到 KirikoBot/.dashboard_password 并打印在启动日志里。
# DASHBOARD_AUTH="1"          # 设为 0 关闭鉴权（不建议）
# DASHBOARD_USER="admin"
# DASHBOARD_PASSWORD=""

# ── 数据保留与备份 ──────────────────────────────────
# 原始消息表的保留天数（0 = 永久保留）。画像/好感度/工具统计等聚合数据不受影响。
# RETENTION_DAYS="180"
# 每天自动备份数据库（使用 SQLite 在线备份 API，WAL 安全）
# BACKUP_ENABLED="1"
# BACKUP_KEEP="14"
# 备份目录；默认在应用目录下的 backups/（容器内即 /app/backups）
# 改成别的位置需要同时给容器加挂载
# BACKUP_DIR=""

# ── AI 用量统计 ─────────────────────────────────────
# 每次调用 DeepSeek 都会记录延迟 / token / 成败，面板「AI 用量」页可看
# AI_METRICS_ENABLED="1"
# 成本估算单价（美元 / 每 100 万 token，高峰价；低谷自动减半）
# 默认值对应 deepseek-flash 的官方定价，调价后在这里覆盖即可
# AI_PRICE_CACHE_HIT="0.006"    # 输入·缓存命中
# AI_PRICE_CACHE_MISS="0.30"    # 输入·缓存未命中
# AI_PRICE_OUTPUT="1.20"        # 输出
