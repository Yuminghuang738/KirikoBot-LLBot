llbot-docker.sh
# docker-compose.yml is tracked on purpose: without it a fresh clone cannot
# start, and the LLBot bridge depends on the llbot_config mount it declares.
# The copy under KirikoBot/ is a stale leftover from an older layout; the
# compose file actually in use lives at the repository root.
KirikoBot/docker-compose.yml

